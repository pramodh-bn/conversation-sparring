# Copy to .env in the directory where you start the server.
# Replace the blank values with your own configuration. Never commit .env.
# Blank credentials keep the server in scripted mode.

# Meta live character and coach (both key and base are required).
# Placeholders: <your-meta-api-key> and <official-meta-api-base-url>
META_MODEL_API_KEY=
META_MODEL_API_BASE=
META_MODEL_API_MODEL=muse-spark-1.3

# Optional Baseten client configuration; this does not select the server backend.
# Placeholder: <your-baseten-api-key> (distinct from the Meta key)
BASETEN_API_KEY=
BASETEN_API_BASE=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
